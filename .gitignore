scripts/tsmis_auth.json

# Local Claude Code permission state (not app code).
.claude/

# output/ holds generated files (potentially gigabytes). Keep the folder
# structure committed via .gitkeep stubs, but ignore everything else so
# exports and consolidated workbooks don't accidentally get checked in.
output/*
!output/ramp_summary/
!output/ramp_detail/
!output/highway_sequence/
!output/highway_log/
!output/highway_log_pdf/
!output/intersection_summary/
!output/intersection_detail/
!output/consolidated/
output/ramp_summary/*
output/ramp_detail/*
output/highway_sequence/*
output/highway_log/*
output/highway_log_pdf/*
output/intersection_summary/*
output/intersection_detail/*
output/consolidated/*
!output/ramp_summary/.gitkeep
!output/ramp_detail/.gitkeep
!output/highway_sequence/.gitkeep
!output/highway_log/.gitkeep
!output/highway_log_pdf/.gitkeep
!output/intersection_summary/.gitkeep
!output/intersection_detail/.gitkeep
!output/consolidated/.gitkeep

# Belt-and-suspenders for the two legacy TSN consolidators: their standalone /
# console (.bat) runs write Caltrans-internal TSN data into output/ rather than
# the dedicated tsn_library/ tree (consolidate_tsn_highway_log -> output/
# tsn_highway_log/ + output/tsn_highway_log_consolidated.xlsx;
# consolidate_tsn_highway_sequence -> output/tsn_highway_sequence_consolidated
# .xlsx). The output/* rule above already ignores them, but these EXPLICIT rules
# come AFTER the output allowlist so a future "!output/<subdir>/" entry mirroring
# the report folders can never silently make real Caltrans data trackable.
# NEVER add an "!output/tsn_*" allowlist entry. (The GUI/matrices build through
# the git-ignored tsn_library/ tree instead; see scripts/tsn_library.py.)
output/tsn_highway_log/
output/tsn_highway_sequence/
output/tsn_*_consolidated.xlsx
output/tsn_*_normalized.xlsx

# (v0.30.0 retired the input/ folder — user-supplied TSN district PDFs now live
# in the git-ignored tsn_library/<report>/raw/ tree, ignored below.)
input/

__pycache__/
*.pyc
.venv/

# Build artifacts (portable onefolder packaging). Keep build\app.spec, build.ps1,
# build\prune_bundle.ps1 and build\full_smoke.py tracked; ignore the heavy
# generated pieces. (build\ms-playwright\ is a defensive no-op now -- no browser
# is bundled -- but stays ignored in case a browser is ever bundled again.)
/dist/
build/ms-playwright/
build/pyi-work/
/TSMIS-Exporter-*.zip          # the distributable zip (uploaded to GitHub Releases)

# Phase 1 packaging spike (throwaway -- superseded by build/)
spike/

# Runtime diagnostics written next to the app (dev: repo root). The rotating
# log and per-failure screenshots/HTML are local artifacts, never committed.
/logs/
/failures/
/edge_login_profile/
/data/edge_login_profile/
/webview2/
/data/webview2/

# Built-in Chromium downloaded from the Settings tab (paths.DOWNLOADED_BROWSERS_DIR;
# dev: repo root, packaged app: data\ms-playwright). Never committed.
/ms-playwright/
/data/ms-playwright/

# Persisted user settings (timeouts, URL overrides — local state, never committed)
/config.json
/data/config.json

# Per-comparison durations for the live ETA (M1-B; local state, never committed)
/compare_timings.json
/data/compare_timings.json

# Export-Everything batch manifest (B3; paths.DATA_ROOT/batch_job.json — dev:
# repo root, packaged app: data\batch_job.json). Local run state, never committed.
/batch_job.json
/data/batch_job.json

# Canonical TSN library (paths.TSN_LIBRARY_ROOT; dev: repo root, packaged app:
# data\tsn_library). Holds the user's REAL TSN source + consolidated files,
# which are LOCAL ONLY (Caltrans-internal) and must NEVER be committed. The
# packaged data\ location is covered by the blanket /data/ rule below; this is
# the dev-root one. (ensure_layout() seeds folders/hints here on app start.)
/tsn_library/

# ArcGIS layer exports (paths.ARCGIS_LAYERS_ROOT; dev: repo root, packaged app:
# data\arcgis_layers). The owner's manually-stocked exports of the TSMIS ArcGIS
# layers -- LOCAL ONLY (Caltrans-internal) and often hundreds of MB, so never
# committed. Same rule and reason as tsn_library/ above.
# (arcgis_layers.ensure_layout() seeds the folder + README on app start.)
/arcgis_layers/

# The packaged app's data dir (profiles, caches, settings, manifests, downloaded
# browser). All current contents are ignored individually above; this blanket
# rule is defense-in-depth so a future data\ file can't be committed by accident.
/data/

# Local scratch area for code-review audit runs. The reusable prompt is the
# tracked docs/code-review-prompt.md; per-run reports quote code +
# internal detail, so they stay local (never committed).
/code-review/

# A corrupt config.json is preserved next to the original for recovery; the
# evidence bundle lands in DATA_ROOT (dev: the repo root). Both can carry user
# paths/URLs -- never committable.
/config.json.corrupt
/data/config.json.corrupt
/tsmis_evidence_*.zip

# Working trees for the comparison-perfection audit runs (oracles, product
# witnesses, family gates). These are GENERATED, and their workbooks/PDFs are
# derived from the LOCAL-ONLY Caltrans corpus -- so like output/ and
# tsn_library/ they must never be committed. They also break tooling that
# stages the whole worktree: check_source_zip_smoke does `git add -A`, and the
# generated `.cmpv3-…comparison-payload.zlib` sidecar names made deep paths
# exceed the legacy path limit before CMP-AUD-242 shortened them. Audit
# instruments live in build/ (phase*.py); only their OUTPUT lands here.
/tmp/

# Re-derivable speed caches (dev data root = the repo root; see paths.CACHE_DIR).
/cache/
